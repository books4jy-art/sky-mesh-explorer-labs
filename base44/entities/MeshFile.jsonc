{
  "name": "MeshFile",
  "type": "object",
  "properties": {
    "driveFileId": {
      "type": "string",
      "unique": true
    },
    "name": {
      "type": "string"
    },
    "size": {
      "type": "number",
      "default": 0
    },
    "folderPath": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "driveFileId",
    "name"
  ]
}
