{
  "name": "LibrarySyncStatus",
  "type": "object",
  "properties": {
    "lastSyncedAt": {
      "type": "string",
      "format": "date-time"
    },
    "fileCount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "default": "idle"
    },
    "cacheFileUrl": {
      "type": "string"
    }
  },
  "required": []
}
